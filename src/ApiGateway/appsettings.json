{
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": { "Path": "/auth/{**catch-all}" },
                "Transforms": [
                    { "PathRemovePrefix": "/auth" }
                ]
            },
            "attendance-route": {
                "ClusterId": "attendance-cluster",
                "Match": { "Path": "/attendance/{**catch-all}" },
                "Transforms": [
                    { "PathRemovePrefix": "/attendance" }
                ]
            }
        },
        "Clusters": {
            "auth-cluster": {
                "Destinations": {
                    "auth-destination": {
                        "Address": "http://authservice:8080/"
                    }
                }
            },
            "attendance-cluster": {
                "Destinations": {
                    "attendance-destination": {
                        "Address": "http://attendanceservice:8080/"
                    }
                }
            }
        }
    }
}